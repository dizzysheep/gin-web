# ================ 配置文件 ==============
# 配置参数统一用驼峰(CamelCase)名称，首字母大写
# 注释时，注释内容在配置参数上面,字符串一定要用双引号
# =======================================
[app]
appName = "gin-web"
appAddr = ":6060"
readTimeout = 60
writeTimeout = 60
env = "dev"
runMode = "debug"
[db_blog]
maxIdle = 10
# 最大连接数
maxActive = 100
# 超时时间,单位秒
idleTimeout = 3600
# 数据库类型
type = "mysql"
# 前缀
tablePrefix = "blog_"
#Dsn
dsn = "root:root@tcp(127.0.0.1:3306)/blog?charset=utf8mb4&parseTime=true&loc=Local"
[redis]
addr = "127.0.0.1:6379"
password = ""
db = 0
[log]
dbMode = true
#日志最低级别
logFormatter = "json"
logLevel = "debug"
apisRequestLogOff = true
filePath = "./runtime/logs/"
[jwt]
secret = "23347$040412"
expireTime = 7200
[upload]
# 存储驱动 local(本地磁盘) 预留oss
driver = "local"
# 本地存储根目录（生产环境建议由Nginx直接托管该目录）
path = "./runtime/uploads"
# 访问URL前缀
urlPrefix = "/uploads"
# 单文件大小上限(MB)
maxSize = 5
# 允许的扩展名
allowExt = "jpg,jpeg,png,gif,webp"
[job]
# 浏览量Redis缓冲刷盘间隔(秒)
viewFlushSec = 600
[site]
# RSS/Sitemap 对外地址；留空时按请求 Host 自动生成
baseURL = ""
title = "gin-web 个人博客"
description = "基于 gin-web 的个人博客"
[skywalking]
switchOn=false
samplingRate=1
host="localhost:11800"
